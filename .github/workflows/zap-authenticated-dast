name: DAST (ZAP Authenticated)

on:
  workflow_call:
    inputs:
      staging_web_url:
        description: "Base URL of staging frontend (Netlify)"
        required: true
        type: string

      zap_login_url:
        description: "Login URL for form auth"
        required: true
        type: string

      zap_username_field:
        description: "Username field name in POST body"
        required: true
        type: string

      zap_password_field:
        description: "Password field name in POST body"
        required: true
        type: string

      zap_logged_in_regex:
        description: "Regex that appears when logged in"
        required: true
        type: string

      zap_logged_out_regex:
        description: "Regex that appears when logged out"
        required: true
        type: string

      spider_minutes:
        description: "Spider max duration (minutes)"
        required: false
        type: number
        default: 5

      passive_minutes:
        description: "Passive scan wait max duration (minutes)"
        required: false
        type: number
        default: 5

      fail_on_warning:
        description: "Fail the job on warnings (true/false)"
        required: false
        type: boolean
        default: false

    secrets:
      zap_username:
        required: true
      zap_password:
        required: true

permissions:
  contents: read

jobs:
  zap_auth:
    name: ZAP Authenticated Scan
    runs-on: ubuntu-latest

    env:
      STAGING_WEB_URL: ${{ inputs.staging_web_url }}
      ZAP_LOGIN_URL: ${{ inputs.zap_login_url }}
      ZAP_USERNAME_FIELD: ${{ inputs.zap_username_field }}
      ZAP_PASSWORD_FIELD: ${{ inputs.zap_password_field }}
      ZAP_LOGGED_IN_REGEX: ${{ inputs.zap_logged_in_regex }}
      ZAP_LOGGED_OUT_REGEX: ${{ inputs.zap_logged_out_regex }}
      ZAP_USERNAME: ${{ secrets.zap_username }}
      ZAP_PASSWORD: ${{ secrets.zap_password }}
      SPIDER_MINS: ${{ inputs.spider_minutes }}
      PASSIVE_MINS: ${{ inputs.passive_minutes }}
      FAIL_ON_WARNING: ${{ inputs.fail_on_warning }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Validate inputs
        run: |
          set -euo pipefail
          req() { if [ -z "${1:-}" ]; then echo "Missing: $2"; exit 1; fi; }

          req "$STAGING_WEB_URL" "staging_web_url"
          req "$ZAP_LOGIN_URL" "zap_login_url"
          req "$ZAP_USERNAME_FIELD" "zap_username_field"
          req "$ZAP_PASSWORD_FIELD" "zap_password_field"
          req "$ZAP_LOGGED_IN_REGEX" "zap_logged_in_regex"
          req "$ZAP_LOGGED_OUT_REGEX" "zap_logged_out_regex"
          req "$ZAP_USERNAME" "zap_username (secret)"
          req "$ZAP_PASSWORD" "zap_password (secret)"

          echo "Target: $STAGING_WEB_URL"
          code="$(curl -sS -o /dev/null -w "%{http_code}" "$STAGING_WEB_URL" || true)"
          echo "HTTP (root): $code"

      - name: Prepare workspace permissions
        run: |
          set -euo pipefail
          chmod -R a+rwx "$GITHUB_WORKSPACE"

      - name: Write ZAP Automation plan (authenticated)
        run: |
          set -euo pipefail

          # Convert boolean to zap's expected true/false string
          if [ "$FAIL_ON_WARNING" = "true" ]; then
            WARN_FLAG="true"
          else
            WARN_FLAG="false"
          fi

          mkdir -p .zap
          cat > .zap/zap.yaml <<EOF
env:
  parameters:
    failOnError: true
    failOnWarning: ${WARN_FLAG}

  contexts:
    - name: "staging"
      urls:
        - "${STAGING_WEB_URL}"
      includePaths:
        - "${STAGING_WEB_URL}.*"

      authentication:
        method: "form"
        parameters:
          loginUrl: "${ZAP_LOGIN_URL}"
          loginRequestData: "${ZAP_USERNAME_FIELD}={%username%}&${ZAP_PASSWORD_FIELD}={%password%}"
        verification:
          method: "poll"
          loggedInIndicator: "${ZAP_LOGGED_IN_REGEX}"
          loggedOutIndicator: "${ZAP_LOGGED_OUT_REGEX}"

      sessionManagement:
        method: "cookie"

      users:
        - name: "zap-user"
          credentials:
            username: "${ZAP_USERNAME}"
            password: "${ZAP_PASSWORD}"

jobs:
  - type: "spider"
    parameters:
      context: "staging"
      user: "zap-user"
      maxDuration: ${SPIDER_MINS}

  - type: "passiveScan-wait"
    parameters:
      maxDuration: ${PASSIVE_MINS}

  - type: "report"
    parameters:
      template: "traditional-html"
      reportDir: "/zap/wrk"
      reportFile: "report_html.html"

  - type: "report"
    parameters:
      template: "traditional-json"
      reportDir: "/zap/wrk"
      reportFile: "report_json.json"

  - type: "report"
    parameters:
      template: "traditional-md"
      reportDir: "/zap/wrk"
      reportFile: "report_md.md"
EOF

      - name: Run ZAP Automation Framework
        run: |
          set -euo pipefail
          docker pull ghcr.io/zaproxy/zaproxy:stable -q

          docker run --rm \
            -v "$GITHUB_WORKSPACE":/zap/wrk/:rw \
            --network host \
            ghcr.io/zaproxy/zaproxy:stable \
            zap.sh -cmd -autorun /zap/wrk/.zap/zap.yaml

      - name: Upload ZAP reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: zap-dast-report
          path: |
            report_html.html
            report_json.json
            report_md.md
