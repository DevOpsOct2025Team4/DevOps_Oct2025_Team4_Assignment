{
  "name": "devops-assignment",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter ./client dev",
    "setup": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "start": "pnpm create-docker",
    "build": "pnpm --filter ./client build",
    "lint": "pnpm --filter ./client lint && pnpm lint:server",
    "lint:server": "python -m ruff check server",
    "create-local-db": "docker compose up -d db",
    "create-docker-server": "docker compose up -d --build server",
    "create-docker": "docker compose up -d --build"
  }
}
