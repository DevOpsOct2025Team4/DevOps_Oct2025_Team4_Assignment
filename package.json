{
  "name": "devops-assignment",
  "private": true,
  "version": "0.0.0",
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "scripts": {
    "predev": "pnpm create-local-db && pnpm migrate",
    "dev": "concurrently -n client,server -c cyan,magenta \"pnpm --filter ./client dev\" \"cd server && python app.py\"",
    "dev:client": "pnpm --filter ./client dev",
    "dev:server": "cd server && python app.py",
    "setup": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "start": "pnpm create-docker",
    "k8": "powershell -ExecutionPolicy Bypass -File scripts/k8s-up.ps1 -PortForward",
    "k8:deploy": "powershell -ExecutionPolicy Bypass -File scripts/k8s-deploy.ps1",
    "k8:test": "powershell -ExecutionPolicy Bypass -File robot\\run-robot.ps1 -BaseUrl http://localhost:5174",
    "migrate": "powershell -ExecutionPolicy Bypass -File scripts/migrate.ps1",
    "build": "pnpm --filter ./client build",
    "lint": "pnpm --filter ./client lint && pnpm lint:server",
    "lint:server": "python -m ruff check server",
    "check": "pnpm lint && python -m pre_commit run --all-files",
    "robot": "powershell -ExecutionPolicy Bypass -File robot\\run-robot.ps1",
    "test:backend": "python -m pytest -q server",
    "test:robot": "pnpm robot",
    "test": "pnpm test:backend && pnpm test:robot",
    "create-local-db": "docker compose up -d db",
    "create-docker-server": "docker compose up -d --build server",
    "create-docker": "docker compose up -d --build",
    "dbstudio": "docker compose up -d dbstudio && echo DB Studio: http://localhost:8080"
  }
}
